{
  "rewrites": [
    { "source": "/noticias",            "destination": "/api/list-noticias" },
    { "source": "/noticias/:slug",      "destination": "/api/noticia?slug=:slug" },
    { "source": "/guias",               "destination": "/api/list-guia" },
    { "source": "/guias/:slug",         "destination": "/api/guia?slug=:slug" },
    { "source": "/curiosidades",        "destination": "/api/list-curiosidad" },
    { "source": "/curiosidades/:id",    "destination": "/api/curiosidad?id=:id" },
    { "source": "/otros",               "destination": "/api/list-otros" },
    { "source": "/otros/:slug",         "destination": "/api/otros?slug=:slug" },
    { "source": "/api/supabase-proxy", "destination": "/api/supabase-proxy" }
  ],
  "redirects": [
    { "source": "/index.html",      "destination": "/",             "permanent": true },
    { "source": "/noticia.html",    "destination": "/noticias",     "permanent": true },
    { "source": "/guia.html",       "destination": "/guias",        "permanent": true },
    { "source": "/curiosidad.html", "destination": "/curiosidades", "permanent": true },
    { "source": "/otros.html",      "destination": "/otros",        "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://mtkesqoywahieuapftmh.supabase.co https://cdn.jsdelivr.net https://minecraft-en-espanol.vercel.app" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",  "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/buscar-noticias", "schedule": "0 8 * * *" }
  ]
}
